{
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/Newsletters/queue_server/**",
    "src/interop.ts.org"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "lib": [
      "ES2021",
      "DOM"
    ],
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  }
}
